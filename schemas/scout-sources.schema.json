{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack Scout source list",
  "description": "Explicit, auditable list of approved feeds for one content profile, version 1.0. No crawling: only these feeds are read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "profile", "fetch_mode", "keywords", "limits", "sources"],
  "properties": {
    "config_version": { "const": "1.0" },
    "profile": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string", "maxLength": 300 },
    "fetch_mode": { "enum": ["fixture", "http"] },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "\\S" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items_per_source", "max_bytes_per_source", "timeout_seconds", "max_candidates_per_run"],
      "properties": {
        "max_items_per_source": { "type": "integer", "minimum": 1, "maximum": 50 },
        "max_bytes_per_source": { "type": "integer", "minimum": 1024, "maximum": 2000000 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "max_candidates_per_run": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "name", "publisher", "kind", "category", "enabled", "feed_url", "link_hosts"],
        "properties": {
          "source_id": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
          "publisher": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
          "kind": { "enum": ["official", "press", "community", "other"] },
          "category": { "enum": ["official_publisher", "official_parent_company", "press", "community", "other"] },
          "enabled": { "type": "boolean" },
          "feed_url": { "type": "string", "maxLength": 2048 },
          "link_hosts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", "maxLength": 253 }
          },
          "fixture": { "type": "string", "minLength": 1, "maxLength": 300 },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  }
}

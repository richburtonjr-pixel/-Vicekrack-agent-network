{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hq_scene",
  "description": "Display data for the Living HQ (Steps 32-33): per-event frames from a Step 31 timeline or the synthetic demo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "mode",
    "mode_label",
    "timeline",
    "rooms",
    "stations",
    "frames",
    "current",
    "unmapped_components",
    "issues",
    "notice"
  ],
  "properties": {
    "contract": {
      "const": "hq_scene"
    },
    "version": {
      "const": "1.1"
    },
    "mode": {
      "enum": [
        "demo",
        "recorded_replay",
        "reconstructed",
        "observed"
      ]
    },
    "mode_label": {
      "type": "string",
      "maxLength": 300
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline_id",
        "origin",
        "department",
        "kind",
        "completeness",
        "outcome",
        "live",
        "time_basis",
        "started_at",
        "event_count",
        "run_id",
        "source",
        "issues",
        "correlation_id"
      ],
      "properties": {
        "timeline_id": {
          "type": "string",
          "pattern": "^(r?tl-[0-9a-f]{24}|demo)$"
        },
        "origin": {
          "enum": [
            "recorded",
            "reconstructed",
            "demo"
          ]
        },
        "department": {
          "enum": [
            "trading",
            "content",
            "both"
          ]
        },
        "kind": {
          "enum": [
            "research_agent_workflow",
            "simulation",
            "content_production",
            "hq_demo",
            "research_review_workflow",
            "content_quality"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "open",
            "interrupted"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "failed",
                "aborted",
                "persistence_failed",
                "event_limit_reached"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "live": {
          "type": "boolean"
        },
        "time_basis": {
          "enum": [
            "recorded_at_emission",
            "source_recorded",
            "simulated_only",
            "synthetic",
            "none_saved"
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^((rar|srun|prod)-[0-9a-f]{24}|wfr-[0-9a-f]{32})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^cor-[0-9a-f]{24}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "rooms": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "room",
          "label",
          "floor",
          "department",
          "bot",
          "components",
          "mapping",
          "role",
          "inputs",
          "decisions",
          "outputs",
          "has_activity",
          "event_count"
        ],
        "properties": {
          "room": {
            "enum": [
              "market_scout",
              "trend_agent",
              "strategy_agent",
              "risk_review",
              "researcher",
              "analyst",
              "reviewer",
              "creator",
              "operations",
              "lounge",
              "kitchen"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "floor": {
            "enum": [
              "upper",
              "ground",
              "shared"
            ]
          },
          "department": {
            "enum": [
              "trading",
              "content",
              "shared"
            ]
          },
          "bot": {
            "anyOf": [
              {
                "enum": [
                  "market_scout",
                  "trend_agent",
                  "strategy_agent",
                  "risk_review",
                  "researcher",
                  "analyst",
                  "reviewer",
                  "creator",
                  "operations",
                  "lounge",
                  "kitchen"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "components": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "pattern": "^(trading|content)\\.[a-z0-9_.]{1,90}$"
            }
          },
          "mapping": {
            "type": "string",
            "maxLength": 300
          },
          "role": {
            "type": "string",
            "maxLength": 300
          },
          "inputs": {
            "type": "string",
            "maxLength": 300
          },
          "decisions": {
            "type": "string",
            "maxLength": 300
          },
          "outputs": {
            "type": "string",
            "maxLength": 300
          },
          "has_activity": {
            "type": "boolean"
          },
          "event_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "event",
          "room",
          "bot",
          "component_states",
          "room_states",
          "handoff"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "event_type",
              "status",
              "component",
              "stage",
              "department",
              "sim_time_utc",
              "recorded_at",
              "reason_codes",
              "refs",
              "details",
              "run_id"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "event_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "status": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "component": {
                "type": "string",
                "pattern": "^(trading|content)\\.[a-z0-9_.]{1,90}$"
              },
              "stage": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "department": {
                "enum": [
                  "trading",
                  "content"
                ]
              },
              "sim_time_utc": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recorded_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason_codes": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              },
              "refs": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object"
                }
              },
              "details": {
                "type": "object"
              },
              "run_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^((rar|srun|prod)-[0-9a-f]{24}|wfr-[0-9a-f]{32})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "room": {
            "anyOf": [
              {
                "enum": [
                  "market_scout",
                  "trend_agent",
                  "strategy_agent",
                  "risk_review",
                  "researcher",
                  "analyst",
                  "reviewer",
                  "creator",
                  "operations",
                  "lounge",
                  "kitchen"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "bot": {
            "anyOf": [
              {
                "enum": [
                  "market_scout",
                  "trend_agent",
                  "strategy_agent",
                  "risk_review",
                  "researcher",
                  "analyst",
                  "reviewer",
                  "creator",
                  "operations",
                  "lounge",
                  "kitchen"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "component_states": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(trading|content)\\.[a-z0-9_.]{1,90}$"
            },
            "additionalProperties": {
              "enum": [
                "idle",
                "working",
                "waiting",
                "blocked",
                "completed",
                "failed",
                "unknown"
              ]
            }
          },
          "room_states": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "market_scout",
                "trend_agent",
                "strategy_agent",
                "risk_review",
                "researcher",
                "analyst",
                "reviewer",
                "creator",
                "operations",
                "lounge",
                "kitchen"
              ]
            },
            "additionalProperties": {
              "enum": [
                "idle",
                "working",
                "waiting",
                "blocked",
                "completed",
                "failed",
                "unknown"
              ]
            }
          },
          "handoff": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "from_station",
                  "to_station"
                ],
                "properties": {
                  "from": {
                    "enum": [
                      "market_scout",
                      "trend_agent",
                      "strategy_agent",
                      "risk_review",
                      "researcher",
                      "analyst",
                      "reviewer",
                      "creator",
                      "operations",
                      "lounge",
                      "kitchen"
                    ]
                  },
                  "to": {
                    "enum": [
                      "market_scout",
                      "trend_agent",
                      "strategy_agent",
                      "risk_review",
                      "researcher",
                      "analyst",
                      "reviewer",
                      "creator",
                      "operations",
                      "lounge",
                      "kitchen"
                    ]
                  },
                  "from_station": {
                    "anyOf": [
                      {
                        "enum": [
                          "research_controller",
                          "simulator",
                          "workflow_orchestrator",
                          "production_pipeline",
                          "brief_builder",
                          "script_validator",
                          "scene_planner",
                          "preview_renderer",
                          "quality_checker"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "to_station": {
                    "anyOf": [
                      {
                        "enum": [
                          "research_controller",
                          "simulator",
                          "workflow_orchestrator",
                          "production_pipeline",
                          "brief_builder",
                          "script_validator",
                          "scene_planner",
                          "preview_renderer",
                          "quality_checker"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "current": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component_states",
            "room_states",
            "notes"
          ],
          "properties": {
            "component_states": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "idle",
                  "working",
                  "waiting",
                  "blocked",
                  "completed",
                  "failed",
                  "unknown"
                ]
              }
            },
            "room_states": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "market_scout",
                  "trend_agent",
                  "strategy_agent",
                  "risk_review",
                  "researcher",
                  "analyst",
                  "reviewer",
                  "creator",
                  "operations",
                  "lounge",
                  "kitchen"
                ]
              },
              "additionalProperties": {
                "enum": [
                  "idle",
                  "working",
                  "waiting",
                  "blocked",
                  "completed",
                  "failed",
                  "unknown"
                ]
              }
            },
            "notes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            }
          }
        }
      ]
    },
    "unmapped_components": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^(trading|content)\\.[a-z0-9_.]{1,90}$"
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "notice": {
      "type": "string",
      "maxLength": 400
    },
    "stations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "station",
          "label",
          "short",
          "department",
          "component",
          "role",
          "has_activity",
          "event_count"
        ],
        "properties": {
          "station": {
            "enum": [
              "research_controller",
              "simulator",
              "workflow_orchestrator",
              "production_pipeline",
              "brief_builder",
              "script_validator",
              "scene_planner",
              "preview_renderer",
              "quality_checker"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "short": {
            "type": "string",
            "maxLength": 20
          },
          "department": {
            "enum": [
              "trading",
              "content"
            ]
          },
          "component": {
            "type": "string",
            "pattern": "^(trading|content)\\.[a-z0-9_.]{1,90}$"
          },
          "role": {
            "type": "string",
            "maxLength": 300
          },
          "has_activity": {
            "type": "boolean"
          },
          "event_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

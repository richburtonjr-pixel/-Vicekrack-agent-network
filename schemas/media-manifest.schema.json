{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack media manifest (Step 42)",
  "description": "Assigns explicitly supplied local image or video files to the four scene-plan beats. Paths are relative to a caller-supplied media root. Rights fields are declarations, not verified clearances. No URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "manifest_id", "plan_id", "mute_source_audio", "assets", "assignments"],
  "properties": {
    "contract": {"const": "media_manifest"},
    "version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9-]{8,64}$"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mute_source_audio": {"const": true},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "relative_path", "kind", "sha256", "bytes", "provenance", "rights"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[a-z0-9-]{2,40}$"},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,159}$"},
          "kind": {"enum": ["image", "video"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 32, "maximum": 83886080},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 80},
              "note": {"type": "string", "maxLength": 200}
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "declaration", "declared_by"],
            "properties": {
              "status": {"const": "declared_not_verified"},
              "declaration": {"type": "string", "minLength": 8, "maxLength": 240},
              "declared_by": {"type": "string", "minLength": 1, "maxLength": 60}
            }
          }
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_index", "asset_id", "fit", "anchor"],
        "properties": {
          "scene_index": {"type": "integer", "minimum": 1, "maximum": 4},
          "asset_id": {"type": "string", "pattern": "^[a-z0-9-]{2,40}$"},
          "fit": {"enum": ["cover", "contain"]},
          "anchor": {"enum": ["center", "top", "bottom"]},
          "trim": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_seconds", "end_seconds"],
            "properties": {
              "start_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
            }
          },
          "image_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 15}
        }
      }
    }
  }
}

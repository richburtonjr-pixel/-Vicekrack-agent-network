{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack editorial profile",
  "description": "Configurable, subject-neutral editorial priorities for Story Selection, version 1.0. Weights never include audience popularity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "profile", "relevance", "topics", "rumor_terms", "weights", "thresholds", "history", "limits"],
  "properties": {
    "profile_version": { "const": "1.0" },
    "profile": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string", "maxLength": 300 },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_terms", "related_terms"],
      "properties": {
        "core_terms": { "$ref": "#/$defs/terms", "minItems": 1 },
        "related_terms": { "$ref": "#/$defs/terms" }
      }
    },
    "topics": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic_id", "priority", "terms", "angle"],
        "properties": {
          "topic_id": { "$ref": "#/$defs/identifier" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "terms": { "$ref": "#/$defs/terms", "minItems": 1 },
          "angle": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" }
        }
      }
    },
    "rumor_terms": { "$ref": "#/$defs/terms" },
    "weights": {
      "description": "Points per component; must total 100. There is deliberately no audience/popularity weight.",
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "authority", "corroboration", "recency", "relevance", "significance"],
      "properties": {
        "confidence": { "type": "integer", "minimum": 20, "maximum": 60 },
        "authority": { "type": "integer", "minimum": 0, "maximum": 40 },
        "corroboration": { "type": "integer", "minimum": 0, "maximum": 30 },
        "recency": { "type": "integer", "minimum": 0, "maximum": 30 },
        "relevance": { "type": "integer", "minimum": 0, "maximum": 30 },
        "significance": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select_min_score", "hold_min_score", "select_max_age_days", "stale_after_days", "max_selections_per_run"],
      "properties": {
        "select_min_score": { "type": "integer", "minimum": 1, "maximum": 100 },
        "hold_min_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "select_max_age_days": { "type": "integer", "minimum": 1, "maximum": 60 },
        "stale_after_days": { "type": "integer", "minimum": 2, "maximum": 365 },
        "max_selections_per_run": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_entries", "window_days", "duplicate_threshold", "similar_threshold"],
      "properties": {
        "max_entries": { "type": "integer", "minimum": 1, "maximum": 500 },
        "window_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "duplicate_threshold": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "similar_threshold": { "type": "number", "minimum": 0.2, "maximum": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_records"],
      "properties": { "max_records": { "type": "integer", "minimum": 1, "maximum": 500 } }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "terms": {
      "type": "array", "maxItems": 40, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+( [a-z0-9]+)*$", "maxLength": 60 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack Story Candidate",
  "description": "One possible story discovered by the Scout, version 1.0. Always unverified: only a later Verification stage may decide what is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "candidate_id", "content_profile", "source", "url", "title",
    "published_at", "retrieved_at", "excerpt", "candidate_claims", "matched_keywords",
    "fingerprints", "verification", "provenance"
  ],
  "properties": {
    "contract": { "const": "story_candidate" },
    "version": { "const": "1.0" },
    "candidate_id": { "type": "string", "pattern": "^cand-[0-9a-f]{24}$" },
    "content_profile": { "$ref": "#/$defs/identifier" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "publisher", "kind", "category"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/text", "maxLength": 100 },
        "publisher": { "$ref": "#/$defs/text", "maxLength": 100 },
        "kind": { "enum": ["official", "press", "community", "other"] },
        "category": { "enum": ["official_publisher", "official_parent_company", "press", "community", "other"] }
      }
    },
    "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
    "title": { "$ref": "#/$defs/text", "maxLength": 200 },
    "published_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "retrieved_at": { "$ref": "#/$defs/timestamp" },
    "excerpt": { "type": "string", "maxLength": 600 },
    "candidate_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "basis", "status"],
        "properties": {
          "claim_id": { "enum": ["k1", "k2", "k3"] },
          "text": { "$ref": "#/$defs/text", "maxLength": 300 },
          "basis": { "enum": ["headline", "excerpt"] },
          "status": { "const": "unverified" }
        }
      }
    },
    "matched_keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url_sha256", "title_sha256"],
      "properties": {
        "url_sha256": { "$ref": "#/$defs/sha256" },
        "title_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_before"],
      "properties": {
        "status": { "const": "unverified" },
        "required_before": { "const": "story_brief" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "fetch_mode", "sources_config_sha256"],
      "properties": {
        "created_by": { "const": "scout" },
        "fetch_mode": { "enum": ["fixture", "http"] },
        "sources_config_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}

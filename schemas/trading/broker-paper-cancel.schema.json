{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/broker-paper-cancel.schema.json",
  "title": "Paper cancel request (Step 41; not a confirmed cancellation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "intent_id",
    "sequence",
    "requested_at",
    "broker_order_id",
    "result",
    "reason"
  ],
  "properties": {
    "contract": {
      "const": "broker_paper_cancel"
    },
    "version": {
      "const": "1.0"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^bpi-[0-9a-f]{24}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "requested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "broker_order_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{8,64}$"
    },
    "result": {
      "enum": [
        "cancel_requested",
        "not_cancelable",
        "not_found",
        "unknown"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      ]
    }
  }
}

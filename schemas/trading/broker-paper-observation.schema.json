{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/broker-paper-observation.schema.json",
  "title": "Broker-confirmed paper order state (Step 41)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "intent_id",
    "sequence",
    "observed_at",
    "source",
    "found",
    "matches_intent",
    "order"
  ],
  "properties": {
    "contract": {
      "const": "broker_paper_observation"
    },
    "version": {
      "const": "1.0"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^bpi-[0-9a-f]{24}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "enum": [
        "submit_response",
        "status_lookup"
      ]
    },
    "found": {
      "type": "boolean"
    },
    "matches_intent": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "order": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "broker_order_id",
            "client_order_id",
            "symbol",
            "side",
            "type",
            "time_in_force",
            "status",
            "qty",
            "filled_qty",
            "filled_avg_price",
            "limit_price",
            "extended_hours",
            "submitted_at",
            "filled_at",
            "canceled_at",
            "expired_at",
            "updated_at"
          ],
          "properties": {
            "broker_order_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{8,64}$"
            },
            "client_order_id": {
              "type": "string",
              "maxLength": 128
            },
            "symbol": {
              "type": "string",
              "maxLength": 20
            },
            "side": {
              "type": "string",
              "maxLength": 10
            },
            "type": {
              "type": "string",
              "maxLength": 20
            },
            "time_in_force": {
              "type": "string",
              "maxLength": 10
            },
            "status": {
              "type": "string",
              "maxLength": 30
            },
            "qty": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
                }
              ]
            },
            "filled_qty": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
            },
            "filled_avg_price": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
                }
              ]
            },
            "limit_price": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
                }
              ]
            },
            "extended_hours": {
              "type": "boolean"
            },
            "submitted_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              ]
            },
            "filled_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              ]
            },
            "canceled_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              ]
            },
            "expired_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              ]
            },
            "updated_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              ]
            }
          }
        }
      ]
    }
  }
}

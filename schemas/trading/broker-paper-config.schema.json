{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/broker-paper-config.schema.json",
  "title": "Alpaca paper broker configuration (Step 41)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "mode",
    "description",
    "data_feed",
    "allowed_time_in_force",
    "kill_switch",
    "limits",
    "network"
  ],
  "properties": {
    "config_version": {
      "const": "1.0"
    },
    "mode": {
      "const": "alpaca_paper"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "data_feed": {
      "enum": [
        "iex",
        "sip"
      ]
    },
    "allowed_time_in_force": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "day"
      }
    },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engaged",
        "note"
      ],
      "properties": {
        "engaged": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_order_notional",
        "max_position_notional",
        "max_quantity",
        "max_open_orders",
        "max_submissions_per_day",
        "min_limit_price",
        "max_limit_above_ask_bps",
        "max_limit_below_bid_bps",
        "max_spread_bps",
        "max_quote_age_seconds",
        "max_clock_skew_seconds",
        "min_seconds_before_close",
        "intent_ttl_seconds",
        "not_found_settle_seconds"
      ],
      "properties": {
        "max_order_notional": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "max_position_notional": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "max_quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_open_orders": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_submissions_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "min_limit_price": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "max_limit_above_ask_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "max_limit_below_bid_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "max_spread_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "max_quote_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_clock_skew_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "min_seconds_before_close": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23400
        },
        "intent_ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "not_found_settle_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_response_bytes",
        "max_open_orders_listed"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000000
        },
        "max_open_orders_listed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    }
  }
}

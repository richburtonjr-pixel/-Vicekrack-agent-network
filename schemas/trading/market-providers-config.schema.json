{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/market-providers-config.schema.json",
  "title": "Opt-in historical market-data provider configuration (Step 40)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "description",
    "alpaca"
  ],
  "properties": {
    "config_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "alpaca": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feeds",
        "adjustments",
        "earliest_date",
        "limits"
      ],
      "properties": {
        "feeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "iex",
              "sip"
            ]
          }
        },
        "adjustments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "raw",
              "split",
              "dividend",
              "all"
            ]
          }
        },
        "earliest_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_seconds",
            "max_pages",
            "page_limit",
            "max_response_bytes",
            "max_total_bytes",
            "max_bars",
            "max_range_days"
          ],
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "page_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 20000000
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 100000000
            },
            "max_bars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "max_range_days": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "1m",
                "5m",
                "15m",
                "30m",
                "1h",
                "1d"
              ],
              "properties": {
                "1m": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3660
                },
                "5m": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3660
                },
                "15m": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3660
                },
                "30m": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3660
                },
                "1h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3660
                },
                "1d": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3660
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/analytics-config.schema.json",
  "title": "Simulation analytics limits 1.0",
  "description": "Bounds for read-only simulation analytics (Step 30).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "limits"
  ],
  "properties": {
    "config_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_curve_points",
        "max_trades",
        "max_cli_items"
      ],
      "properties": {
        "max_curve_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_trades": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_cli_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    }
  }
}

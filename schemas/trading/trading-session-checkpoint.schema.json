{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/trading-session-checkpoint.schema.json",
  "title": "Trading research session checkpoint (Step 39)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "session_id",
    "revision",
    "status",
    "updated_at",
    "stages",
    "previous_sha256",
    "checkpoint_sha256"
  ],
  "properties": {
    "contract": {
      "const": "trading_session_checkpoint"
    },
    "version": {
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^tss-[0-9a-f]{24}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "created",
        "running",
        "failed",
        "completed"
      ]
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "position",
          "status",
          "attempts",
          "artifact"
        ],
        "properties": {
          "stage": {
            "enum": [
              "dataset_validation",
              "research_analysis",
              "simulation",
              "performance_analytics",
              "hq_summary"
            ]
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "attempts": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt",
                "reason",
                "started_at",
                "ended_at",
                "outcome",
                "error_code",
                "events"
              ],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "reason": {
                  "enum": [
                    "first_run",
                    "retry_after_failure",
                    "retry_after_interruption"
                  ]
                },
                "started_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "ended_at": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                    }
                  ]
                },
                "outcome": {
                  "enum": [
                    "running",
                    "completed",
                    "failed",
                    "interrupted",
                    "recovered"
                  ]
                },
                "error_code": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    }
                  ]
                },
                "events": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "recorded",
                    "timeline_id",
                    "outcome"
                  ],
                  "properties": {
                    "recorded": {
                      "type": "boolean"
                    },
                    "timeline_id": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^tl-[0-9a-f]{24}$"
                        }
                      ]
                    },
                    "outcome": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,63}$"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "artifact": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "file_sha256",
                  "record_kind",
                  "record_id",
                  "results_sha256",
                  "store"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^artifacts/[1-5]-[a-z_]{1,40}\\.json$"
                  },
                  "file_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "record_kind": {
                    "enum": [
                      "trading_session_dataset_check",
                      "research_agent_run",
                      "simulation_run",
                      "simulation_analytics_report",
                      "trading_session_manifest"
                    ]
                  },
                  "record_id": {
                    "type": "string",
                    "pattern": "^(tsdc|rar|srun|sarp|tsm)-[0-9a-f]{24}$"
                  },
                  "results_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "store": {
                    "enum": [
                      "published",
                      "already_present",
                      "session_only"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/trading-session-dataset-check.schema.json",
  "title": "Dataset validation result for a trading session (Step 39)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "check_id",
    "session_id",
    "dataset",
    "bar_count",
    "first_start_utc",
    "last_available_utc",
    "gap_count",
    "verified_as_authentic",
    "checks",
    "results_sha256",
    "checked_at",
    "notice"
  ],
  "properties": {
    "contract": {
      "const": "trading_session_dataset_check"
    },
    "version": {
      "const": "1.0"
    },
    "check_id": {
      "type": "string",
      "pattern": "^tsdc-[0-9a-f]{24}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^tss-[0-9a-f]{24}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "bars_sha256",
        "source_file_sha256",
        "symbol",
        "interval",
        "timezone",
        "data_label"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^mds-[0-9a-f]{24}$"
        },
        "bars_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "interval": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "bar_count": {
      "type": "integer",
      "minimum": 1
    },
    "first_start_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "last_available_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "gap_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_as_authentic": {
      "const": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "status": {
            "const": "passed"
          }
        }
      }
    },
    "results_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack paper trading configuration",
  "description": "Paper-only limits, version 1.0. No broker or credential fields exist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "mode",
    "account_currency",
    "allowed_symbols",
    "allowed_order_types",
    "allow_short",
    "limits",
    "kill_switch"
  ],
  "properties": {
    "config_version": {
      "const": "1.0"
    },
    "mode": {
      "const": "paper"
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "account_currency": {
      "enum": [
        "USD"
      ]
    },
    "allowed_symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "allowed_order_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "market",
          "limit"
        ]
      }
    },
    "allow_short": {
      "const": false,
      "description": "Short selling is not supported in Step 23."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_order_notional",
        "max_position_notional",
        "max_position_fraction",
        "max_daily_loss",
        "max_orders_per_day",
        "max_quantity",
        "max_snapshot_age_seconds",
        "max_signal_lifetime_seconds"
      ],
      "properties": {
        "max_order_notional": {
          "$ref": "#/$defs/money"
        },
        "max_position_notional": {
          "$ref": "#/$defs/money"
        },
        "max_position_fraction": {
          "type": "string",
          "pattern": "^0(\\.[0-9]{1,4})?$|^1(\\.0{1,4})?$"
        },
        "max_daily_loss": {
          "$ref": "#/$defs/money"
        },
        "max_orders_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_quantity": {
          "$ref": "#/$defs/decimal"
        },
        "max_snapshot_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_signal_lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engaged"
      ],
      "properties": {
        "engaged": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

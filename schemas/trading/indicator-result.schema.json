{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/indicator-result.schema.json",
  "title": "Indicator result 1.0",
  "description": "Deterministic offline indicator values on closed replay bars. Not a signal and not advice; no account access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "result_id",
    "mode",
    "account_access",
    "authorization_possible",
    "dataset",
    "settings",
    "replay",
    "series",
    "summary",
    "results_sha256",
    "created_at",
    "notice"
  ],
  "properties": {
    "contract": {
      "const": "indicator_result"
    },
    "version": {
      "const": "1.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^ind-[0-9a-f]{24}$"
    },
    "mode": {
      "const": "historical_replay"
    },
    "account_access": {
      "const": false
    },
    "authorization_possible": {
      "const": false
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "bars_sha256",
        "source_file_sha256",
        "symbol",
        "interval",
        "timezone",
        "data_label"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/dataset_id"
        },
        "bars_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timezone": {
          "$ref": "#/$defs/timezone"
        },
        "data_label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicators",
        "gap_policy",
        "vwap_session",
        "rounding",
        "settings_sha256"
      ],
      "properties": {
        "indicators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "period"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/indicator_key"
              },
              "kind": {
                "enum": [
                  "ema",
                  "rsi",
                  "volume_sma",
                  "vwap"
                ]
              },
              "period": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "gap_policy": {
          "enum": [
            "reset",
            "continue"
          ]
        },
        "vwap_session": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "timezone",
                "start",
                "end"
              ],
              "properties": {
                "timezone": {
                  "$ref": "#/$defs/timezone"
                },
                "start": {
                  "$ref": "#/$defs/hhmm"
                },
                "end": {
                  "$ref": "#/$defs/hhmm"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "places",
            "mode",
            "internal_precision"
          ],
          "properties": {
            "places": {
              "const": 8
            },
            "mode": {
              "const": "ROUND_HALF_EVEN"
            },
            "internal_precision": {
              "const": 50
            }
          }
        },
        "settings_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc",
        "step_seconds",
        "steps",
        "clock"
      ],
      "properties": {
        "start_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "end_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "step_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31622400
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "clock": {
          "const": "simulation"
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "period",
          "points"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/indicator_key"
          },
          "kind": {
            "enum": [
              "ema",
              "rsi",
              "volume_sma",
              "vwap"
            ]
          },
          "period": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "type": "array",
            "maxItems": 1000000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sequence",
                "timestamp",
                "timestamp_utc",
                "available_at_utc",
                "computed_at_sim_utc",
                "status",
                "value",
                "reason_codes",
                "bars_since_reset"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "timestamp": {
                  "$ref": "#/$defs/local_timestamp"
                },
                "timestamp_utc": {
                  "$ref": "#/$defs/timestamp"
                },
                "available_at_utc": {
                  "$ref": "#/$defs/timestamp"
                },
                "computed_at_sim_utc": {
                  "$ref": "#/$defs/timestamp"
                },
                "status": {
                  "enum": [
                    "ready",
                    "unavailable"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/decimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason_codes": {
                  "type": "array",
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/code"
                  }
                },
                "bars_since_reset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bars_processed",
        "gaps_detected",
        "warmup_resets",
        "sessions",
        "future_access_attempts"
      ],
      "properties": {
        "bars_processed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "gaps_detected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "warmup_resets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "future_access_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      }
    },
    "results_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "notice": {
      "const": "Offline indicator values computed from closed historical bars on a simulation clock. Not a signal, not advice, no orders, no account access. Data is not verified as authentic, current or licensed."
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "local_timestamp": {
      "type": "string",
      "description": "RFC 3339 local time with explicit UTC offset.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-]([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z_+-]+){1,2})$"
    },
    "interval": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "1d"
      ]
    },
    "label": {
      "enum": [
        "synthetic",
        "historical",
        "delayed",
        "unknown"
      ],
      "description": "What the importer declared. Never verified."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^mds-[0-9a-f]{24}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "name"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "synthetic_fixture",
            "local_csv",
            "alpaca_historical"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$"
        }
      }
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "indicator_key": {
      "type": "string",
      "pattern": "^(ema|rsi|volume_sma)_[0-9]{1,3}$|^vwap_session$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/broker-paper-event.schema.json",
  "title": "Sanitized broker-paper execution event (Step 41)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "intent_id",
    "sequence",
    "event_type",
    "recorded_at",
    "reason_codes",
    "details"
  ],
  "properties": {
    "contract": {
      "const": "broker_paper_event"
    },
    "version": {
      "const": "1.0"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^bpi-[0-9a-f]{24}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "event_type": {
      "enum": [
        "prepared",
        "submission_blocked",
        "submission_started",
        "submission_accepted",
        "submission_rejected",
        "submission_unknown",
        "status_observed",
        "reconciliation_not_found",
        "cancel_requested",
        "cancel_not_cancelable",
        "cancel_not_found",
        "cancel_unknown"
      ]
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "prepared",
            "prepared_expired",
            "unknown",
            "mismatch",
            "other_broker_state",
            "accepted",
            "partially_filled",
            "filled",
            "canceled",
            "expired",
            "rejected",
            "not_placed",
            "cancel_pending",
            "cancel_requested",
            "done_for_day"
          ]
        },
        "broker_status": {
          "type": "string",
          "maxLength": 30
        },
        "filled_qty": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        }
      }
    }
  }
}

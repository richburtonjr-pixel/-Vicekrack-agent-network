{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/trading-session-manifest.schema.json",
  "title": "Trading research session manifest (Step 39)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "manifest_id",
    "session_id",
    "correlation_id",
    "simulated",
    "research_used_by_simulation",
    "authorization_possible",
    "dataset",
    "inputs",
    "versions",
    "time_domains",
    "stages",
    "links",
    "results",
    "continuity",
    "results_sha256",
    "created_at",
    "notice"
  ],
  "properties": {
    "contract": {
      "const": "trading_session_manifest"
    },
    "version": {
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^tsm-[0-9a-f]{24}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^tss-[0-9a-f]{24}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor-[0-9a-f]{24}$"
    },
    "simulated": {
      "const": true
    },
    "research_used_by_simulation": {
      "const": false
    },
    "authorization_possible": {
      "const": false
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "bars_sha256",
        "source_file_sha256",
        "symbol",
        "interval",
        "timezone",
        "data_label"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^mds-[0-9a-f]{24}$"
        },
        "bars_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "interval": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_config",
        "market_data",
        "indicators",
        "research_signals",
        "research_agents",
        "simulation_policy",
        "analytics"
      ],
      "properties": {
        "session_config": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "market_data": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "indicators": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "research_signals": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "research_agents": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "simulation_policy": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analytics": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_runner",
        "session_manifest",
        "market_dataset",
        "research_agent_run",
        "research_handlers",
        "simulation_run",
        "simulation_analytics_report"
      ],
      "properties": {
        "session_runner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "session_manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "market_dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "research_agent_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "research_handlers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "simulation_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "simulation_analytics_report": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        }
      }
    },
    "time_domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_data",
        "historical_research",
        "simulated_execution",
        "wall_clock"
      ],
      "properties": {
        "historical_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_start_utc",
            "last_available_utc",
            "label"
          ],
          "properties": {
            "first_start_utc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "last_available_utc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "historical_research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "as_of_utc",
            "rule",
            "relation_to_simulation",
            "used_by_simulation",
            "label"
          ],
          "properties": {
            "as_of_utc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "relation_to_simulation": {
              "enum": [
                "before_simulation_start",
                "during_simulation_window",
                "at_or_after_simulation_end"
              ]
            },
            "used_by_simulation": {
              "const": false
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "simulated_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_utc",
            "end_utc",
            "step_seconds",
            "last_bar_close_utc",
            "label"
          ],
          "properties": {
            "start_utc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "end_utc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "step_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "last_bar_close_utc": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "wall_clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_created_at",
            "label"
          ],
          "properties": {
            "session_created_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "position",
          "time_domain",
          "attempts",
          "artifact",
          "timelines",
          "reconstructable_id"
        ],
        "properties": {
          "stage": {
            "enum": [
              "dataset_validation",
              "research_analysis",
              "simulation",
              "performance_analytics"
            ]
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "time_domain": {
            "enum": [
              "historical_data",
              "historical_research",
              "simulated_execution",
              "derived_from_simulation"
            ]
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt",
                "reason",
                "started_at",
                "ended_at",
                "outcome",
                "error_code",
                "events"
              ],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "reason": {
                  "enum": [
                    "first_run",
                    "retry_after_failure",
                    "retry_after_interruption"
                  ]
                },
                "started_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "ended_at": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                    }
                  ]
                },
                "outcome": {
                  "enum": [
                    "running",
                    "completed",
                    "failed",
                    "interrupted",
                    "recovered"
                  ]
                },
                "error_code": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    }
                  ]
                },
                "events": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "recorded",
                    "timeline_id",
                    "outcome"
                  ],
                  "properties": {
                    "recorded": {
                      "type": "boolean"
                    },
                    "timeline_id": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^tl-[0-9a-f]{24}$"
                        }
                      ]
                    },
                    "outcome": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,63}$"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "file_sha256",
              "record_kind",
              "record_id",
              "results_sha256",
              "store"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^artifacts/[1-5]-[a-z_]{1,40}\\.json$"
              },
              "file_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "record_kind": {
                "enum": [
                  "trading_session_dataset_check",
                  "research_agent_run",
                  "simulation_run",
                  "simulation_analytics_report",
                  "trading_session_manifest"
                ]
              },
              "record_id": {
                "type": "string",
                "pattern": "^(tsdc|rar|srun|sarp|tsm)-[0-9a-f]{24}$"
              },
              "results_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "store": {
                "enum": [
                  "published",
                  "already_present",
                  "session_only"
                ]
              }
            }
          },
          "timelines": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt",
                "timeline_id",
                "origin",
                "outcome"
              ],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "timeline_id": {
                  "type": "string",
                  "pattern": "^tl-[0-9a-f]{24}$"
                },
                "origin": {
                  "const": "recorded"
                },
                "outcome": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    }
                  ]
                }
              }
            }
          },
          "reconstructable_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(rar|srun)-[0-9a-f]{24}$"
              }
            ]
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_rooms",
        "simulator_station",
        "analytics_desk"
      ],
      "properties": {
        "research_rooms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "timeline_id",
            "origin",
            "reason"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "timeline_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(tl|rar|srun)-[0-9a-f]{24}$"
                }
              ]
            },
            "origin": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "recorded",
                    "reconstructed"
                  ]
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              ]
            }
          }
        },
        "simulator_station": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "timeline_id",
            "origin",
            "reason"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "timeline_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(tl|rar|srun)-[0-9a-f]{24}$"
                }
              ]
            },
            "origin": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "recorded",
                    "reconstructed"
                  ]
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              ]
            }
          }
        },
        "analytics_desk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "timeline_id",
            "origin",
            "reason"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "timeline_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(tl|rar|srun)-[0-9a-f]{24}$"
                }
              ]
            },
            "origin": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "recorded",
                    "reconstructed"
                  ]
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              ]
            }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_verdict",
        "research_run_id",
        "simulation_run_id",
        "analytics_report_id",
        "fills",
        "orders_created",
        "orders_rejected",
        "ending_equity",
        "net_return",
        "closed_trades",
        "kill_switch_engaged"
      ],
      "properties": {
        "research_verdict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "research_run_id": {
          "type": "string",
          "pattern": "^rar-[0-9a-f]{24}$"
        },
        "simulation_run_id": {
          "type": "string",
          "pattern": "^srun-[0-9a-f]{24}$"
        },
        "analytics_report_id": {
          "type": "string",
          "pattern": "^sarp-[0-9a-f]{24}$"
        },
        "fills": {
          "type": "integer",
          "minimum": 0
        },
        "orders_created": {
          "type": "integer",
          "minimum": 0
        },
        "orders_rejected": {
          "type": "integer",
          "minimum": 0
        },
        "ending_equity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "net_return": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "closed_trades": {
          "type": "integer",
          "minimum": 0
        },
        "kill_switch_engaged": {
          "type": "boolean"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "explanation"
      ],
      "properties": {
        "kind": {
          "const": "separate_stage_timelines"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "results_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    }
  }
}

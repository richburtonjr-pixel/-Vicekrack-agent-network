{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack trading journal event",
  "description": "One structured, append-only journal event, version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "event_id",
    "correlation_id",
    "causation_id",
    "sequence",
    "recorded_at",
    "stage",
    "status",
    "agent",
    "subject",
    "observed",
    "reason_codes",
    "document",
    "document_sha256",
    "mode",
    "simulated"
  ],
  "properties": {
    "contract": {
      "const": "trading_journal_event"
    },
    "version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.1 (Step 24) adds account-state stages, the paper_state agent and account/operation subjects."
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9a-f]{32}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{32}$"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^evt-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "stage": {
      "enum": [
        "run_started",
        "market_snapshot",
        "signal",
        "risk_check",
        "order_intent",
        "run_finished",
        "state_initialized",
        "intent_cancelled",
        "state_recovery"
      ]
    },
    "status": {
      "enum": [
        "started",
        "accepted",
        "rejected",
        "allowed",
        "blocked",
        "recorded",
        "completed",
        "failed",
        "cancelled",
        "committed",
        "rolled_back"
      ]
    },
    "agent": {
      "enum": [
        "trading_demo",
        "demo_market_data",
        "demo_strategy",
        "risk_engine",
        "paper_order_desk",
        "paper_state"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "symbol": {
          "type": "string",
          "maxLength": 80
        },
        "snapshot_id": {
          "type": "string",
          "maxLength": 80
        },
        "signal_id": {
          "type": "string",
          "maxLength": 80
        },
        "decision_id": {
          "type": "string",
          "maxLength": 80
        },
        "intent_id": {
          "type": "string",
          "maxLength": 80
        },
        "scenario": {
          "type": "string",
          "maxLength": 80
        },
        "account_id": {
          "type": "string",
          "maxLength": 80
        },
        "operation_id": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "observed": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z0-9_]{1,40}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean",
          "null"
        ],
        "maxLength": 200
      }
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "document": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "The validated contract this agent saw or produced (snapshot, signal, decision or intent)."
    },
    "document_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "const": "paper"
    },
    "simulated": {
      "const": true
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack paper portfolio state",
  "description": "Risk input: simulated account state, version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "portfolio_id",
    "as_of",
    "currency",
    "equity",
    "positions",
    "day",
    "synthetic"
  ],
  "properties": {
    "contract": {
      "const": "paper_portfolio_state"
    },
    "version": {
      "const": "1.0"
    },
    "portfolio_id": {
      "type": "string",
      "pattern": "^port-[a-z0-9-]{4,64}$"
    },
    "as_of": {
      "$ref": "#/$defs/timestamp"
    },
    "currency": {
      "enum": [
        "USD"
      ]
    },
    "equity": {
      "$ref": "#/$defs/money"
    },
    "positions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "quantity",
          "average_price"
        ],
        "properties": {
          "symbol": {
            "$ref": "#/$defs/symbol"
          },
          "quantity": {
            "$ref": "#/$defs/signed_decimal"
          },
          "average_price": {
            "$ref": "#/$defs/decimal"
          }
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trading_date",
        "pnl"
      ],
      "properties": {
        "trading_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "pnl": {
          "$ref": "#/$defs/signed_money"
        }
      }
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/ohlcv-bar.schema.json",
  "title": "OHLCV bar 1.0",
  "description": "One validated bar as handed to replay consumers. Timestamp is the bar start; available_at_utc is when the bar closes and may first be seen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "dataset_id",
    "sequence",
    "symbol",
    "interval",
    "timezone",
    "timestamp",
    "timestamp_utc",
    "available_at_utc",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "currency",
    "source",
    "data_label"
  ],
  "properties": {
    "contract": {
      "const": "ohlcv_bar"
    },
    "version": {
      "const": "1.0"
    },
    "dataset_id": {
      "$ref": "#/$defs/dataset_id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "symbol": {
      "$ref": "#/$defs/symbol"
    },
    "interval": {
      "$ref": "#/$defs/interval"
    },
    "timezone": {
      "$ref": "#/$defs/timezone"
    },
    "timestamp": {
      "$ref": "#/$defs/local_timestamp"
    },
    "timestamp_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "available_at_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "open": {
      "$ref": "#/$defs/decimal"
    },
    "high": {
      "$ref": "#/$defs/decimal"
    },
    "low": {
      "$ref": "#/$defs/decimal"
    },
    "close": {
      "$ref": "#/$defs/decimal"
    },
    "volume": {
      "$ref": "#/$defs/decimal"
    },
    "currency": {
      "$ref": "#/$defs/currency"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "data_label": {
      "$ref": "#/$defs/label"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "local_timestamp": {
      "type": "string",
      "description": "RFC 3339 local time with explicit UTC offset.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-]([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z_+-]+){1,2})$"
    },
    "interval": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "1d"
      ]
    },
    "label": {
      "enum": [
        "synthetic",
        "historical",
        "delayed",
        "unknown"
      ],
      "description": "What the importer declared. Never verified."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^mds-[0-9a-f]{24}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "name"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "synthetic_fixture",
            "local_csv",
            "alpaca_historical"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$"
        }
      }
    }
  }
}

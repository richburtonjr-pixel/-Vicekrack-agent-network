{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack market snapshot",
  "description": "One observation of one symbol, version 1.0. Paper/offline only in Step 23.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "snapshot_id",
    "symbol",
    "observed_at",
    "currency",
    "price",
    "volume",
    "source",
    "freshness",
    "synthetic"
  ],
  "properties": {
    "contract": {
      "const": "market_snapshot"
    },
    "version": {
      "const": "1.0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap-[a-z0-9-]{4,64}$"
    },
    "symbol": {
      "$ref": "#/$defs/symbol"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "currency": {
      "enum": [
        "USD"
      ]
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last",
        "bid",
        "ask"
      ],
      "properties": {
        "last": {
          "$ref": "#/$defs/decimal"
        },
        "bid": {
          "$ref": "#/$defs/decimal"
        },
        "ask": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "volume": {
      "$ref": "#/$defs/decimal"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "synthetic_fixture"
          ],
          "description": "Step 23 accepts only synthetic fixtures; real feeds are out of scope."
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_age_seconds"
      ],
      "properties": {
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

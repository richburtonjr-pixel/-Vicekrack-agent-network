{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/research-signal-config.schema.json",
  "title": "Research signal strategies 1.0",
  "description": "Named rule-based research strategies (Step 27). Research only; never authorizes orders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "limits",
    "strategies"
  ],
  "properties": {
    "config_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_strategies",
        "max_evaluations",
        "max_cli_entries"
      ],
      "properties": {
        "max_strategies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_cli_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "strategies": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50,
      "propertyNames": {
        "$ref": "#/$defs/strategy_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/strategy_def"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "local_timestamp": {
      "type": "string",
      "description": "RFC 3339 local time with explicit UTC offset.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-]([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z_+-]+){1,2})$"
    },
    "interval": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "1d"
      ]
    },
    "label": {
      "enum": [
        "synthetic",
        "historical",
        "delayed",
        "unknown"
      ],
      "description": "What the importer declared. Never verified."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^mds-[0-9a-f]{24}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "name"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "synthetic_fixture",
            "local_csv"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$"
        }
      }
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "indicator_key": {
      "type": "string",
      "pattern": "^(ema|rsi|volume_sma)_[0-9]{1,3}$|^vwap_session$"
    },
    "strategy_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
    },
    "signal_id": {
      "type": "string",
      "pattern": "^rsig-[0-9a-f]{24}$"
    },
    "strategy_def": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "version",
            "params"
          ],
          "properties": {
            "strategy": {
              "const": "vwap_reclaim"
            },
            "version": {
              "const": "1.0"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cooldown_bars",
                "expiry_bars",
                "session"
              ],
              "properties": {
                "cooldown_bars": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "expiry_bars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "session": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "timezone",
                    "start",
                    "end"
                  ],
                  "properties": {
                    "timezone": {
                      "$ref": "#/$defs/timezone"
                    },
                    "start": {
                      "$ref": "#/$defs/hhmm"
                    },
                    "end": {
                      "$ref": "#/$defs/hhmm"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "version",
            "params"
          ],
          "properties": {
            "strategy": {
              "const": "ema_crossover"
            },
            "version": {
              "const": "1.0"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cooldown_bars",
                "expiry_bars",
                "fast",
                "slow"
              ],
              "properties": {
                "cooldown_bars": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "expiry_bars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "fast": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                "slow": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 500
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "version",
            "params"
          ],
          "properties": {
            "strategy": {
              "const": "breakout"
            },
            "version": {
              "const": "1.0"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cooldown_bars",
                "expiry_bars",
                "lookback",
                "volume_filter"
              ],
              "properties": {
                "cooldown_bars": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "expiry_bars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "lookback": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                "volume_filter": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "period",
                        "multiplier"
                      ],
                      "properties": {
                        "period": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 500
                        },
                        "multiplier": {
                          "$ref": "#/$defs/decimal"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}

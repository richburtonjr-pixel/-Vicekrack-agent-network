{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/broker-paper-intent.schema.json",
  "title": "Prepared Alpaca paper order intent (Step 41, immutable)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "contract",
    "version",
    "mode",
    "broker_paper",
    "simulated",
    "real_money",
    "source",
    "account_fingerprint",
    "created_at",
    "expires_at",
    "order",
    "exposure",
    "inputs_at_preparation",
    "preview_checks",
    "config_sha256",
    "notice",
    "client_order_id",
    "consent_phrase"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "pattern": "^bpi-[0-9a-f]{24}$"
    },
    "contract": {
      "const": "broker_paper_intent"
    },
    "version": {
      "const": "1.0"
    },
    "mode": {
      "const": "alpaca_paper"
    },
    "broker_paper": {
      "const": true
    },
    "simulated": {
      "const": false
    },
    "real_money": {
      "const": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "manual_command"
        }
      }
    },
    "account_fingerprint": {
      "type": "string",
      "pattern": "^pacct-[0-9a-f]{24}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "side",
        "qty",
        "type",
        "time_in_force",
        "limit_price",
        "extended_hours"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ]
        },
        "qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "type": {
          "const": "limit"
        },
        "time_in_force": {
          "const": "day"
        },
        "limit_price": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "extended_hours": {
          "const": false
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_notional",
        "explanation"
      ],
      "properties": {
        "max_notional": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "inputs_at_preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "market_open",
        "clock_time_utc",
        "asset"
      ],
      "properties": {
        "quote": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bid",
                "ask",
                "quote_time_utc",
                "feed"
              ],
              "properties": {
                "bid": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
                },
                "ask": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
                },
                "quote_time_utc": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "feed": {
                  "enum": [
                    "iex",
                    "sip"
                  ]
                }
              }
            }
          ]
        },
        "market_open": {
          "type": "boolean"
        },
        "clock_time_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "asset": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "class",
                "exchange",
                "status",
                "tradable"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "maxLength": 20
                },
                "class": {
                  "type": "string",
                  "maxLength": 30
                },
                "exchange": {
                  "type": "string",
                  "maxLength": 20
                },
                "status": {
                  "type": "string",
                  "maxLength": 20
                },
                "tradable": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    },
    "preview_checks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "passed",
          "reason"
        ],
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            ]
          }
        }
      }
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "client_order_id": {
      "type": "string",
      "pattern": "^vk-[0-9a-f]{24}$"
    },
    "consent_phrase": {
      "type": "string",
      "pattern": "^paper-execute:bpi-[0-9a-f]{24}$"
    }
  }
}

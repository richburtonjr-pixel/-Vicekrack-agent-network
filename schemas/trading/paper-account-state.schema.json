{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/paper-account-state.schema.json",
  "title": "Paper account risk state (Step 24) - PAPER ONLY",
  "description": "Persistent paper risk state: processed signals, authorized paper intents with exposure reservations, and daily counters. Authorized paper intents are not submitted orders, executed trades or realized profit/loss.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "account_id",
    "mode",
    "currency",
    "simulated",
    "created_at",
    "updated_at",
    "revision",
    "trading_day",
    "day_history",
    "processed_signals",
    "intents",
    "recoveries",
    "ledger",
    "state_sha256"
  ],
  "properties": {
    "contract": {
      "const": "paper_account_state"
    },
    "version": {
      "const": "1.0"
    },
    "account_id": {
      "$ref": "#/$defs/account_id"
    },
    "mode": {
      "const": "paper"
    },
    "currency": {
      "const": "USD"
    },
    "simulated": {
      "const": true
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "trading_day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "rollover",
        "current_date",
        "authorized_count",
        "cancelled_count",
        "blocked_count",
        "last_decision_at"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z_+-]+){1,2})$",
          "maxLength": 60
        },
        "rollover": {
          "const": "local_midnight"
        },
        "current_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorized_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "cancelled_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "last_decision_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "day_history": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "authorized_count",
          "cancelled_count",
          "blocked_count"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "authorized_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "cancelled_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "blocked_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        }
      }
    },
    "processed_signals": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_id",
          "outcome",
          "decision_id",
          "intent_id",
          "processed_at",
          "trading_date",
          "reason_codes"
        ],
        "properties": {
          "signal_id": {
            "$ref": "#/$defs/signal_id"
          },
          "outcome": {
            "enum": [
              "authorized_paper",
              "blocked",
              "rolled_back"
            ]
          },
          "decision_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/decision_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "intent_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/intent_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "processed_at": {
            "$ref": "#/$defs/timestamp"
          },
          "trading_date": {
            "anyOf": [
              {
                "$ref": "#/$defs/date"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_codes": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/$defs/code"
            }
          }
        }
      }
    },
    "intents": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent_id",
          "signal_id",
          "decision_id",
          "intent_sha256",
          "symbol",
          "side",
          "quantity",
          "order_type",
          "reference_price",
          "notional",
          "trading_date",
          "authorized_at",
          "status",
          "reservation",
          "submitted",
          "executed"
        ],
        "properties": {
          "intent_id": {
            "$ref": "#/$defs/intent_id"
          },
          "signal_id": {
            "$ref": "#/$defs/signal_id"
          },
          "decision_id": {
            "$ref": "#/$defs/decision_id"
          },
          "intent_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "symbol": {
            "$ref": "#/$defs/symbol"
          },
          "side": {
            "enum": [
              "buy",
              "sell"
            ]
          },
          "quantity": {
            "$ref": "#/$defs/decimal"
          },
          "order_type": {
            "enum": [
              "market",
              "limit"
            ]
          },
          "reference_price": {
            "$ref": "#/$defs/decimal"
          },
          "notional": {
            "$ref": "#/$defs/decimal"
          },
          "trading_date": {
            "$ref": "#/$defs/date"
          },
          "authorized_at": {
            "$ref": "#/$defs/timestamp"
          },
          "status": {
            "enum": [
              "authorized_paper",
              "cancelled"
            ]
          },
          "reservation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reserved_quantity",
              "released_at",
              "release_reason",
              "release_note"
            ],
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "released"
                ]
              },
              "reserved_quantity": {
                "$ref": "#/$defs/signed_decimal"
              },
              "released_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "release_reason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/code"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "release_note": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "submitted": {
            "const": false
          },
          "executed": {
            "const": false
          }
        }
      }
    },
    "recoveries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "operation",
          "outcome",
          "recovered_at",
          "signal_ids",
          "reconciled_signal_ids"
        ],
        "properties": {
          "operation_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/operation_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "enum": [
              "authorize",
              "cancel",
              "unknown"
            ]
          },
          "outcome": {
            "enum": [
              "committed",
              "rolled_back",
              "discarded_unreadable",
              "reconciled"
            ]
          },
          "recovered_at": {
            "$ref": "#/$defs/timestamp"
          },
          "signal_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/signal_id"
            }
          },
          "reconciled_signal_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/$defs/signal_id"
            }
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_paper_intents",
        "active_reservations",
        "cancelled_intents",
        "submitted_orders",
        "executed_trades",
        "realized_pnl",
        "note"
      ],
      "properties": {
        "authorized_paper_intents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "active_reservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "cancelled_intents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "submitted_orders": {
          "const": 0
        },
        "executed_trades": {
          "const": 0
        },
        "realized_pnl": {
          "const": null
        },
        "note": {
          "const": "Paper authorizations only. Nothing was submitted or executed; realized P&L is not tracked."
        }
      }
    },
    "state_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^acct-[a-z0-9][a-z0-9-]{2,40}$"
    },
    "signal_id": {
      "type": "string",
      "pattern": "^sig-[a-z0-9-]{4,64}$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^pint-[0-9a-f]{24}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^rdec-[0-9a-f]{24}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op-[0-9a-f]{32}$"
    }
  }
}

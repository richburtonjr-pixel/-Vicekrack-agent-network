{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/trading/indicator-config.schema.json",
  "title": "Indicator limits and defaults 1.0",
  "description": "Offline indicator settings (Step 26). No signals, no orders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "limits",
    "defaults",
    "rounding"
  ],
  "properties": {
    "config_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_indicators",
        "max_period",
        "max_points",
        "max_cli_points"
      ],
      "properties": {
        "max_indicators": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_period": {
          "type": "integer",
          "minimum": 2,
          "maximum": 500
        },
        "max_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_cli_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_policy",
        "vwap_session"
      ],
      "properties": {
        "gap_policy": {
          "enum": [
            "reset",
            "continue"
          ]
        },
        "vwap_session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timezone",
            "start",
            "end"
          ],
          "properties": {
            "timezone": {
              "$ref": "#/$defs/timezone"
            },
            "start": {
              "$ref": "#/$defs/hhmm"
            },
            "end": {
              "$ref": "#/$defs/hhmm"
            }
          }
        }
      }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "places",
        "mode",
        "internal_precision"
      ],
      "properties": {
        "places": {
          "const": 8
        },
        "mode": {
          "const": "ROUND_HALF_EVEN"
        },
        "internal_precision": {
          "const": 50
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "local_timestamp": {
      "type": "string",
      "description": "RFC 3339 local time with explicit UTC offset.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-]([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z_+-]+){1,2})$"
    },
    "interval": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "1d"
      ]
    },
    "label": {
      "enum": [
        "synthetic",
        "historical",
        "delayed",
        "unknown"
      ],
      "description": "What the importer declared. Never verified."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^mds-[0-9a-f]{24}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "name"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "synthetic_fixture",
            "local_csv"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$"
        }
      }
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "indicator_key": {
      "type": "string",
      "pattern": "^(ema|rsi|volume_sma)_[0-9]{1,3}$|^vwap_session$"
    }
  }
}

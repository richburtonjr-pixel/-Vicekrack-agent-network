{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack risk decision",
  "description": "Deterministic paper risk decision, version 1.0. Blocked unless every check passes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "decision_id",
    "mode",
    "signal_id",
    "snapshot_id",
    "decided_at",
    "outcome",
    "reason_codes",
    "checks",
    "inputs"
  ],
  "properties": {
    "contract": {
      "const": "risk_decision"
    },
    "version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^rdec-[0-9a-f]{24}$"
    },
    "mode": {
      "const": "paper"
    },
    "signal_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sig-[a-z0-9-]{4,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^snap-[a-z0-9-]{4,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_at": {
      "$ref": "#/$defs/timestamp"
    },
    "outcome": {
      "enum": [
        "allowed",
        "blocked"
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "limit",
          "observed"
        ],
        "properties": {
          "check": {
            "$ref": "#/$defs/code"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "limit": {
            "anyOf": [
              {
                "$ref": "#/$defs/signed_decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/signed_decimal"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_sha256",
        "signal_sha256",
        "snapshot_sha256",
        "portfolio_sha256"
      ],
      "properties": {
        "config_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "signal_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "portfolio_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "decimal": {
      "description": "Non-negative decimal as a string (no floats, exponents, NaN or infinity).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "signed_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "money": {
      "description": "Non-negative amount in account currency, at most 2 decimal places.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "signed_money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

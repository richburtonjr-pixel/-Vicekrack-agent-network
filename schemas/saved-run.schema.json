{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved workflow run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "registry_path",
    "task",
    "config",
    "history",
    "trace",
    "status",
    "pending_stage",
    "created_at",
    "updated_at",
    "outcome"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "registry_path": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "workflow",
        "contract_hashes"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "definition",
              "enabled",
              "capabilities",
              "execution"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "execution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "adapter",
                  "model"
                ],
                "properties": {
                  "adapter": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "workflow": {
          "type": [
            "object",
            "null"
          ]
        },
        "contract_hashes": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "trace": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "uncertain",
        "failed",
        "completed"
      ]
    },
    "pending_stage": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 3
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "outcome": {
      "type": [
        "object",
        "null"
      ]
    },
    "workflow_state": {
      "type": "object"
    }
  }
}

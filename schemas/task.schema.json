{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack Agent Task",
  "description": "Provider-neutral task request and lifecycle outcome, version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "sender", "recipient", "instructions", "status", "created_at", "updated_at"],
  "properties": {
    "execution_trace": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "agent",
          "provider",
          "status"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "agent": {
            "enum": [
              "researcher",
              "analyst",
              "reviewer"
            ]
          },
          "provider": {
            "enum": [
              "mock",
              "openai",
              "anthropic"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "failed"
            ]
          }
        }
      }
    },
    "schema_version": { "const": "1.0" },
    "task_id": { "$ref": "#/$defs/identifier" },
    "parent_task_id": { "$ref": "#/$defs/identifier" },
    "sender": { "$ref": "#/$defs/identifier" },
    "recipient": { "$ref": "#/$defs/identifier" },
    "instructions": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "context": { "type": "object", "additionalProperties": true },
    "status": { "enum": ["queued", "running", "completed", "failed"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "data": { "type": "object", "additionalProperties": true }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "message": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "status": { "enum": ["queued", "running"] } },
      "not": { "anyOf": [{ "required": ["result"] }, { "required": ["error"] }] }
    },
    {
      "properties": { "status": { "const": "completed" } },
      "required": ["result"],
      "not": { "required": ["error"] }
    },
    {
      "properties": { "status": { "const": "failed" } },
      "required": ["error"],
      "not": { "required": ["result"] }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 128 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack article fetch policy",
  "description": "Explicit, auditable list of hosts and path prefixes whose article pages may be fetched for Scout candidates, version 1.0. No crawling: only a candidate's own link is fetched.",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "profile", "fetch_mode", "limits", "sources"],
  "properties": {
    "config_version": { "const": "1.0" },
    "profile": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string", "maxLength": 300 },
    "fetch_mode": { "enum": ["fixture", "http"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_articles_per_run", "max_bytes_per_article", "timeout_seconds", "max_redirects",
                   "max_sentences_per_article", "max_text_chars"],
      "properties": {
        "max_articles_per_run": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_bytes_per_article": { "type": "integer", "minimum": 1024, "maximum": 2000000 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "max_redirects": { "type": "integer", "minimum": 0, "maximum": 5 },
        "max_sentences_per_article": { "type": "integer", "minimum": 1, "maximum": 80 },
        "max_text_chars": { "type": "integer", "minimum": 500, "maximum": 30000 }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "enabled", "hosts", "path_prefixes"],
        "properties": {
          "source_id": { "$ref": "#/$defs/identifier" },
          "enabled": { "type": "boolean" },
          "hosts": {
            "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", "maxLength": 253 }
          },
          "path_prefixes": {
            "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]*/$", "maxLength": 200 }
          },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "fixtures": {
      "description": "Fixture mode only: candidate URL -> local HTML file inside the project.",
      "type": "object", "maxProperties": 50,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  }
}

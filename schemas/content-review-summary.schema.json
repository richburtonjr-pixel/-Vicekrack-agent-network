{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content_review_summary",
  "description": "Step 38 DERIVED summary of Step 37 review records about one quality report, a snapshot at export time. Not an original record: each decision keeps its review ID and the SHA-256 of its original file. Reviewer labels and notes appear only when explicitly included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "derived",
    "statement",
    "snapshot_at",
    "report_id",
    "binding_digest",
    "history_status",
    "other_decisions_not_about_this_report",
    "current_preview_approval_at_export",
    "approval",
    "evidence_at_export",
    "reviewer_labels_included",
    "review_notes_included",
    "decisions"
  ],
  "properties": {
    "contract": {
      "const": "content_review_summary"
    },
    "version": {
      "const": "1.0"
    },
    "derived": {
      "const": true
    },
    "statement": {
      "type": "string",
      "maxLength": 600
    },
    "snapshot_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^qr-[0-9a-f]{24}$"
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "history_status": {
      "enum": [
        "none_saved",
        "available"
      ]
    },
    "other_decisions_not_about_this_report": {
      "type": "integer",
      "minimum": 0
    },
    "current_preview_approval_at_export": {
      "type": "boolean"
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_id",
            "acknowledgments",
            "conditions_at_review",
            "meaning"
          ],
          "properties": {
            "review_id": {
              "type": "string",
              "pattern": "^rev-[0-9a-f]{24}$"
            },
            "acknowledgments": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            },
            "conditions_at_review": {
              "type": "object"
            },
            "meaning": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      ]
    },
    "evidence_at_export": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "age_hours",
        "max_age_days"
      ],
      "properties": {
        "status": {
          "enum": [
            "fresh",
            "stale",
            "unavailable"
          ]
        },
        "age_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_age_days": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "reviewer_labels_included": {
      "type": "boolean"
    },
    "review_notes_included": {
      "type": "boolean"
    },
    "decisions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "sequence",
          "decision",
          "recorded_at",
          "report_id",
          "binding_digest",
          "acknowledgments",
          "supersedes",
          "superseded_by",
          "record_sha256",
          "conditions_at_review",
          "applicability_at_export",
          "artifact_binding_at_export",
          "current_preview_approval_at_export",
          "reasons_at_export"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "pattern": "^rev-[0-9a-f]{24}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "decision": {
            "enum": [
              "approved_for_preview",
              "changes_requested",
              "rejected"
            ]
          },
          "recorded_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "report_id": {
            "type": "string",
            "pattern": "^qr-[0-9a-f]{24}$"
          },
          "binding_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "acknowledgments": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "enum": [
                "needs_review_result",
                "unavailable_checks",
                "draft_restrictions",
                "stale_evidence"
              ]
            }
          },
          "supersedes": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^rev-[0-9a-f]{24}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "superseded_by": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^rev-[0-9a-f]{24}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "conditions_at_review": {
            "type": "object"
          },
          "applicability_at_export": {
            "enum": [
              "current",
              "superseded",
              "invalidated",
              "unavailable"
            ]
          },
          "artifact_binding_at_export": {
            "enum": [
              "matching",
              "changed",
              "unavailable"
            ]
          },
          "current_preview_approval_at_export": {
            "type": "boolean"
          },
          "reasons_at_export": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "reviewer_label": {
            "type": "string",
            "maxLength": 64
          },
          "reviewer_authenticated": {
            "const": false
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicekrack.local/schemas/hq-broker-paper-intent.schema.json",
  "title": "Living HQ paper-broker intent detail (Step 41, read-only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "read_only",
    "broker_paper",
    "simulated",
    "real_money",
    "notice",
    "intent_id",
    "created_at",
    "symbol",
    "side",
    "qty",
    "limit_price",
    "max_notional",
    "state",
    "terminal",
    "reconciled",
    "outcome",
    "broker_status",
    "filled_qty",
    "filled_avg_price",
    "submitted_at",
    "last_observed_at",
    "observations",
    "cancel_requests",
    "client_order_id",
    "time_in_force",
    "expires_at",
    "exposure",
    "quote_at_preparation",
    "preview_checks",
    "submission_checks",
    "events",
    "commands"
  ],
  "properties": {
    "contract": {
      "const": "hq_broker_paper_intent"
    },
    "version": {
      "const": "1.0"
    },
    "read_only": {
      "const": true
    },
    "broker_paper": {
      "const": true
    },
    "simulated": {
      "const": false
    },
    "real_money": {
      "const": false
    },
    "notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "intent_id": {
      "type": "string",
      "pattern": "^bpi-[0-9a-f]{24}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ]
    },
    "qty": {
      "type": "integer",
      "minimum": 1
    },
    "limit_price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "max_notional": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "state": {
      "enum": [
        "prepared",
        "prepared_expired",
        "unknown",
        "mismatch",
        "other_broker_state",
        "accepted",
        "partially_filled",
        "filled",
        "canceled",
        "expired",
        "rejected",
        "not_placed",
        "cancel_pending",
        "cancel_requested",
        "done_for_day"
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "reconciled": {
      "type": "boolean"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "accepted",
            "rejected",
            "unknown",
            "no_answer_recorded"
          ]
        }
      ]
    },
    "broker_status": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 30
        }
      ]
    },
    "filled_qty": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "filled_avg_price": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        }
      ]
    },
    "submitted_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      ]
    },
    "last_observed_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      ]
    },
    "observations": {
      "type": "integer",
      "minimum": 0
    },
    "cancel_requests": {
      "type": "integer",
      "minimum": 0
    },
    "client_order_id": {
      "type": "string",
      "pattern": "^vk-[0-9a-f]{24}$"
    },
    "time_in_force": {
      "const": "day"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "exposure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "quote_at_preparation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bid",
            "ask",
            "quote_time_utc",
            "feed"
          ],
          "properties": {
            "bid": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
            },
            "ask": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
            },
            "quote_time_utc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "feed": {
              "enum": [
                "iex",
                "sip"
              ]
            }
          }
        }
      ]
    },
    "preview_checks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "passed",
          "reason"
        ],
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            ]
          }
        }
      }
    },
    "submission_checks": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "passed",
              "reason"
            ],
            "properties": {
              "check": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "passed": {
                "type": "boolean"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "events": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_type",
          "recorded_at",
          "reason_codes",
          "details"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "recorded_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "reason_codes": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "details": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "prepared",
                  "prepared_expired",
                  "unknown",
                  "mismatch",
                  "other_broker_state",
                  "accepted",
                  "partially_filled",
                  "filled",
                  "canceled",
                  "expired",
                  "rejected",
                  "not_placed",
                  "cancel_pending",
                  "cancel_requested",
                  "done_for_day"
                ]
              },
              "broker_status": {
                "type": "string",
                "maxLength": 30
              },
              "filled_qty": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}

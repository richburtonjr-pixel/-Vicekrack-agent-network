{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack Article Evidence",
  "description": "Text extracted from one fetched article page for a Scout candidate, version 1.0. Always unverified: it is evidence for the Verifier, never a verified fact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "article_id", "candidate_id", "content_profile", "source", "requested_url",
               "final_url", "redirects", "fetched_at", "fetch_mode", "http_status", "content_type", "content_sha256",
               "text_sha256", "published_at", "published_at_origin", "page_title", "sentences", "excluded",
               "truncated", "verification"],
  "properties": {
    "contract": { "const": "article_evidence" },
    "version": { "const": "1.0" },
    "article_id": { "type": "string", "pattern": "^art-[0-9a-f]{24}$" },
    "candidate_id": { "type": "string", "pattern": "^cand-[0-9a-f]{24}$" },
    "content_profile": { "$ref": "#/$defs/identifier" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "publisher", "kind", "category"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["official", "press", "community", "other"] },
        "category": { "enum": ["official_publisher", "official_parent_company", "press", "community", "other"] }
      }
    },
    "requested_url": { "$ref": "#/$defs/url" },
    "final_url": { "$ref": "#/$defs/url" },
    "redirects": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/url" } },
    "fetched_at": { "$ref": "#/$defs/timestamp" },
    "fetch_mode": { "enum": ["fixture", "http"] },
    "http_status": { "const": 200 },
    "content_type": { "enum": ["text/html", "application/xhtml+xml"] },
    "content_sha256": { "$ref": "#/$defs/sha256" },
    "text_sha256": { "$ref": "#/$defs/sha256" },
    "published_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "published_at_origin": {
      "description": "Where published_at came from, or why it is null. Fetch time is never used.",
      "enum": ["meta_article_published_time", "json_ld_date_published", "time_element", "feed",
               "unavailable", "ambiguous", "imprecise", "future", "conflicts_with_feed"]
    },
    "page_title": { "type": ["string", "null"], "maxLength": 200 },
    "sentences": {
      "type": "array", "minItems": 1, "maxItems": 80,
      "items": { "type": "string", "minLength": 20, "maxLength": 300, "pattern": "\\S" }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_like", "too_long"],
      "properties": {
        "instruction_like": { "type": "integer", "minimum": 0 },
        "too_long": { "type": "integer", "minimum": 0 }
      }
    },
    "truncated": { "type": "boolean" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "unverified" } }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "url": { "type": "string", "pattern": "^https://[^?#\\s]+$", "maxLength": 2048 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}

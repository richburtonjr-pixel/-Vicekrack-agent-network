{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vicekrack production quality report",
  "description": "Technical quality checks for one production run. Version 1.0 (Step 22, legacy) records no artifact hashes. Version 1.1 (Step 36) adds `binding`: the exact files the checks read (role, safe reference, SHA-256, size) and whether they stayed unchanged during inspection. A pass means the local artifacts are internally consistent; binding means only byte identity. Neither means facts are accurate, rights are cleared or publishing is allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "report_id",
    "production_id",
    "checked_at",
    "result",
    "reasons",
    "checks",
    "scope",
    "notes"
  ],
  "properties": {
    "contract": {
      "const": "production_quality_report"
    },
    "version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "report_id": {
      "type": "string",
      "pattern": "^qr-[0-9a-f]{24}$"
    },
    "production_id": {
      "type": "string",
      "pattern": "^prod-[0-9a-f]{24}$"
    },
    "checked_at": {
      "$ref": "#/$defs/timestamp"
    },
    "result": {
      "enum": [
        "pass",
        "needs_review",
        "fail"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 60,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "reasons",
          "details"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "state",
              "artifacts",
              "provenance",
              "evidence_freshness",
              "draft_restrictions",
              "scene_timing",
              "video",
              "audio",
              "manifest_consistency",
              "history"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "needs_review",
              "fail",
              "unavailable"
            ]
          },
          "reasons": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/code"
            }
          },
          "details": {
            "type": "object",
            "maxProperties": 20,
            "propertyNames": {
              "pattern": "^[a-z0-9_]{1,40}$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ],
              "maxLength": 200
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical_checks_only",
        "factual_accuracy_verified",
        "rights_cleared",
        "publishable",
        "permission_to_publish"
      ],
      "properties": {
        "technical_checks_only": {
          "const": true
        },
        "factual_accuracy_verified": {
          "const": false
        },
        "rights_cleared": {
          "const": false
        },
        "publishable": {
          "const": false
        },
        "permission_to_publish": {
          "const": false
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_version",
        "status",
        "reasons",
        "integrity_only",
        "artifacts",
        "configuration",
        "note"
      ],
      "properties": {
        "binding_version": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "bound",
            "changed_during_inspection",
            "incomplete"
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "integrity_only": {
          "const": true
        },
        "artifacts": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "ref",
              "id",
              "index",
              "sha256",
              "bytes",
              "status"
            ],
            "properties": {
              "role": {
                "enum": [
                  "production_state",
                  "brief",
                  "script",
                  "scene_plan",
                  "preview_manifest",
                  "media_manifest",
                  "video",
                  "poster",
                  "verification_record",
                  "narration"
                ]
              },
              "ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?!\\.\\.?(/|$))[A-Za-z0-9._-]+(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]+){0,3}$",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^ver-[0-9a-f]{24}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "index": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "read",
                  "missing",
                  "unreadable",
                  "too_large"
                ]
              }
            }
          }
        },
        "configuration": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "sha256",
              "status"
            ],
            "properties": {
              "name": {
                "enum": [
                  "verification_policy",
                  "editorial_profile",
                  "creator",
                  "capabilities"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^config/[A-Za-z0-9._-]+\\.json$"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "read",
                  "missing",
                  "unreadable",
                  "too_large"
                ]
              }
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,60}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "binding"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "binding"
          ]
        }
      }
    }
  ]
}
